#!/usr/bin/env bash
# headroom-check — measure what HEADROOM.md teaches.
# Zero dependencies. Read-only. Never sends anything anywhere.
#
# Usage:
#   bin/headroom-check                # auto-detect: ~/.hermes + current dir
#   bin/headroom-check <profile-dir>  # check a specific profile
#
# Exit codes: 0 fine · 1 warnings · 2 nothing found
set -uo pipefail

GREEN=""; YELLOW=""; RED=""; RESET=""
[ -t 1 ] && { GREEN="\033[32m"; YELLOW="\033[33m"; RED="\033[31m"; RESET="\033[0m"; }

HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
HERMES_HOME="${HERMES_HOME%/}"
# Hermes shells export HERMES_HOME as a profile dir. A real root contains
# profiles/; a profile dir doesn't. Walk up only when precise — and say so.
if [ ! -d "$HERMES_HOME/profiles" ] && case "$HERMES_HOME" in */profiles/*) true ;; *) false ;; esac; then
  printf 'NOTE: HERMES_HOME=%s looks like a profile dir (no profiles/ inside). Using %s\n' "$HERMES_HOME" "$(dirname "$(dirname "$HERMES_HOME")")"
  HERMES_HOME=$(dirname "$(dirname "$HERMES_HOME")")
fi
PROFILE="${1:-}"

# --- discover profiles (newline-safe: no word splitting on spaces) ---
if [ -n "$PROFILE" ]; then
  PROFILES_SRC=$(printf '%s\n' "$PROFILE")
elif [ -d "$HERMES_HOME/profiles" ]; then
  PROFILES_SRC=$(find "$HERMES_HOME/profiles" -mindepth 1 -maxdepth 1 -type d | sort)
else
  PROFILES_SRC=""
fi

WARN=0
FOUND=0

hdr() { printf '\n%s\n' "$*"; }
row() { # label value budget verdict
  printf '  %-22s %8s   %-14s %b\n' "$1" "$2" "$3" "$4"
}
bytes() {
  [ -e "$1" ] || { echo "-"; return; }
  [ -f "$1" ] || { echo "unreadable"; return; }
  [ -r "$1" ] || { echo "unreadable"; return; }
  local N
  N=$(wc -c < "$1" 2>/dev/null) || { echo "unreadable"; return; }
  printf '%s' "$N" | tr -d ' '
}

# --- global SOUL ---
hdr "SOUL budget (target: every resident file < 1500 bytes)"
G="$HERMES_HOME/SOUL.md"
GB=$(bytes "$G")
if [ "$GB" = "-" ]; then V="${YELLOW}none"
elif [ "$GB" = "unreadable" ]; then V="${RED}UNREADABLE"; WARN=$((WARN+1)); FOUND=$((FOUND+1))
else FOUND=$((FOUND+1));
  V="${GREEN}ok"; [ "$GB" -gt 1500 ] 2>/dev/null && { V="${RED}OVER"; WARN=$((WARN+1)); }
fi
row "global SOUL.md" "${GB}B" "<1500" "$V${RESET}"

# --- per-profile ---
hdr "Profiles"
if [ -z "$PROFILES_SRC" ]; then
  printf '  %bno profiles found under %s\n' "${YELLOW}${RESET}" "$HERMES_HOME/profiles"
else
  while IFS= read -r P; do
    [ -z "$P" ] && continue
    NAME=$(basename "$P")
    SB=$(bytes "$P/SOUL.md")
    if [ "$SB" = "-" ]; then V="${YELLOW}no SOUL"
    elif [ "$SB" = "unreadable" ]; then V="${RED}UNREADABLE"; WARN=$((WARN+1)); FOUND=$((FOUND+1))
    else FOUND=$((FOUND+1));
      V="${GREEN}ok"; [ "$SB" -gt 1500 ] 2>/dev/null && { V="${RED}OVER"; WARN=$((WARN+1)); }
    fi
    SKILLS=$(find "$P/skills" -name "SKILL.md" 2>/dev/null | wc -l | tr -d ' ')
    printf '  %-22s %8s   %-14s %b  · %s skills\n' "$NAME/SOUL" "${SB}B" "<1500" "$V${RESET}" "$SKILLS"
  done <<EOF
$PROFILES_SRC
EOF
fi

# --- project context files (tier 3: auto-loaded, budget like a SOUL) ---
hdr "Project context files (tier 3 — budget like SOUL)  [cwd: $PWD]"
TIER3_FOUND=0
for f in CLAUDE.md AGENTS.md AGENT.md; do
  if [ -f "$f" ]; then
    TIER3_FOUND=$((TIER3_FOUND+1)); FOUND=$((FOUND+1))
    CB=$(bytes "$f")
    if [ "$CB" = "unreadable" ]; then V="${RED}UNREADABLE"; WARN=$((WARN+1))
    else V="${GREEN}ok"; [ "$CB" -gt 3000 ] 2>/dev/null && { V="${YELLOW}big"; WARN=$((WARN+1)); }
    fi
    printf '  %-22s %8s   %-14s %b\n' "$f" "${CB}B" "<3000" "$V${RESET}"
  fi
done
[ "$TIER3_FOUND" = "0" ] && printf '  %bnone in cwd\n' "${YELLOW}${RESET}"

# FIX 6b + canonicality bonus: diverging CLAUDE.md vs AGENTS.md is the
# most common canonicality violation — measure the thing the doc teaches
if [ -f "CLAUDE.md" ] && [ -f "AGENTS.md" ]; then
  if [ ! -L "AGENTS.md" ] && ! head -3 "AGENTS.md" | grep -qiE "see (the )?CLAUDE|^.?$"; then
    if ! cmp -s "CLAUDE.md" "AGENTS.md"; then
      printf '  %-22s %b\n' "CLAUDE≠AGENTS?" "${YELLOW}not identical, not a pointer — diverging copies?${RESET}"
      WARN=$((WARN+1))
    fi
  fi
fi

# --- memory ---
hdr "Agent memory (small + dense beats large + stale)"
for M in "$HERMES_HOME/profiles"/*/memories/MEMORY.md "$HERMES_HOME/memories/MEMORY.md"; do
  [ -f "$M" ] || continue
  FOUND=$((FOUND+1))
  MB=$(bytes "$M")
  if [ "$MB" = "unreadable" ]; then V="${RED}UNREADABLE"; WARN=$((WARN+1))
  else V="${GREEN}ok"; [ "$MB" -gt 5000 ] 2>/dev/null && { V="${YELLOW}prune?"; WARN=$((WARN+1)); }
  fi
  printf '  %-22s %8s   %-14s %b\n' "$(echo "$M" | sed "s|$HERMES_HOME/||;s|/memories.*||") memory" "${MB}B" "<5000" "$V${RESET}"
done
true

# --- habits present? ---
hdr "Habits (presence, not size)"
[ -d "daily-logs" ] && printf '  %b✓%b daily-logs/ exists\n' "$GREEN" "$RESET" || { printf '  %b·%b no daily-logs/ in cwd\n' "$YELLOW" "$RESET"; }
[ -f "NEXT.md" ] && printf '  %b✓%b NEXT.md exists\n' "$GREEN" "$RESET" || { printf '  %b·%b no NEXT.md in cwd\n' "$YELLOW" "$RESET"; }
[ -f "watchlist.md" ] && printf '  %b✓%b watchlist.md exists\n' "$GREEN" "$RESET" || { printf '  %b·%b no watchlist.md in cwd\n' "$YELLOW" "$RESET"; }

# --- verdict ---
printf '\n'
if [ "$FOUND" = "0" ]; then
  printf '%b✗ nothing found — is HERMES_HOME right? (%s) — run hermes-setup first%b\n' "$RED" "$HERMES_HOME" "$RESET"
  exit 2
elif [ "$WARN" -eq 0 ]; then
  printf '%b✓ headroom OK — nothing over budget%b\n' "$GREEN" "$RESET"
  exit 0
else
  printf '%b⚠ %d warning(s) — trim the OVER rows (one line of constraint beats five aphorisms)%b\n' "$YELLOW" "$WARN" "$RESET"
  exit 1
fi
